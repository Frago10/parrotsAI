{
  "manifest_version": 3,
  "name": "CallPilot",
  "description": "Copiloto de IA para llamadas y navegación: lee tu pantalla, escucha la pestaña y te sugiere respuestas en un panel lateral.",
  "version": "__VERSION__",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "CallPilot: abrir panel",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "tabCapture",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "read-screen": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Leer la pantalla y responder"
    },
    "listen-tab": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Escuchar el audio de esta pestaña"
    }
  }
}
