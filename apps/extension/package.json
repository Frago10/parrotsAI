{
  "name": "@callpilot/extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Extensión de Chrome (Manifest V3) de CallPilot: panel lateral con lector de pantalla inteligente y audio de pestaña.",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "pack": "node build.mjs && node pack.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@callpilot/live-core": "workspace:*",
    "@callpilot/shared": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
