[
  {
    "id": "es-001",
    "lang": "es",
    "text": "¿Cuéntame sobre tu experiencia liderando equipos?",
    "isQuestion": true,
    "needsAnswer": true,
    "type": "behavioral"
  },
  {
    "id": "es-002",
    "lang": "es",
    "text": "Cuéntame de una vez en la que tuviste un conflicto con un compañero",
    "isQuestion": true,
    "needsAnswer": true,
    "type": "behavioral"
  },
  {
    "id": "es-003",
    "lang": "es",
    "text": "¿Por qué quieres trabajar con nosotros?",
    "isQuestion": true,
    "needsAnswer": true,
    "type": "behavioral"
  },
  {
    "id": "es-004",
    "lang": "es",
    "text": "Me gustaría saber cómo manejas los plazos ajustados",
    "isQuestion": true,
    "needsAnswer": true,
    "type": "behavioral"
  },
  {
    "id": "es-005",
    "lang": "es",
    "text": "cuéntame de un proyecto del que estés orgulloso",
    "isQuestion": true,
    "needsAnswer": true,
    "type": "behavioral"
  },
  {
    "id": "es-006",
    "lang": "es",
    "text": "Bueno, entonces, cómo describirías tu estilo de liderazgo",
    "isQuestion": true,
    "needsAnswer": true,
    "type": "behavioral"
  },
  {
    "id": "es-007",
    "lang": "es",
    "text": "dónde te ves en cinco años",
    "isQuestion": true,
    "needsAnswer": true,
    "type": "behavioral"
  },
  {
    "id": "es-008",
    "lang": "es",
    "text": "Me encantaría escuchar cómo manejaste un desacuerdo con tu jefe",
    "isQuestion": true,
    "needsAnswer": true,
    "type": "behavioral"
  },
  {
    "id": "es-009",
    "lang": "es",
    "text": "¿Cuál dirías que es tu mayor debilidad?",
    "isQuestion": true,
    "needsAnswer": true,
    "type": "behavioral"
  },
  {
    "id": "es-010",
    "lang": "es",
    "text": "Y qué te motiva a cambiar de trabajo justo ahora",
    "isQuestion": true,
    "needsAnswer": true,
    "type": "behavioral"
  },
  {
    "id": "es-011",
    "lang": "es",
    "text": "¿Tienes alguna pregunta para nosotros?",
    "isQuestion": true,
    "needsAnswer": true,
    "type": "behavioral"
  },
  {
    "id": "es-012",
    "lang": "es",
    "text": "cuándo podrías empezar",
    "isQuestion": true,
    "needsAnswer": true,
    "type": "behavioral"
  },
  {
    "id": "es-013",
    "lang": "es",
    "text": "¿Qué expectativa salarial tienes?",
    "isQuestion": true,
    "needsAnswer": true,
    "type": "behavioral"
  },
  {
    "id": "es-014",
    "lang": "es",
    "text": "Háblame de ti",
    "isQuestion": true,
    "needsAnswer": true,
    "type": "behavioral"
  },
  {
    "id": "es-015",
    "lang": "es",
    "text": "Describe una situación en la que tuviste que tomar una decisión con información incompleta.",
    "isQuestion": true,
    "needsAnswer": true,
    "type": "behavioral"
  },

  {
