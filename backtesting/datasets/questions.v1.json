    "type": "coding"
  },
  {
    "id": "es-035",
    "lang": "es",
    "text": "Ahora invierte una lista enlazada sin usar memoria extra",
    "isQuestion": true,
    "needsAnswer": true,
    "type": "coding"
  },
  {
    "id": "es-036",
