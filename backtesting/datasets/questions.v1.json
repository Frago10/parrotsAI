  {
    "id": "es-029",
    "lang": "es",
    "text": "Escribe una función que invierta una cadena",
    "isQuestion": true,
    "needsAnswer": true,
    "type": "coding"
  },
  {
    "id": "es-030",
    "lang": "es",
    "text": "¿Cómo resolverías el problema de two sum con complejidad lineal?",
    "isQuestion": true,
    "needsAnswer": true,
    "type": "coding"
  },
  {
    "id": "es-031",
    "lang": "es",
    "text": "Implementa una función que devuelva el n-ésimo número de Fibonacci",
    "isQuestion": true,
    "needsAnswer": true,
    "type": "coding"
  },
  {
    "id": "es-032",
    "lang": "es",
    "text": "cómo detectarías duplicados en un arreglo en tiempo lineal",
    "isQuestion": true,
    "needsAnswer": true,
    "type": "coding"
  },
  {
    "id": "es-033",
    "lang": "es",
