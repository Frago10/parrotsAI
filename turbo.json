{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "ALLOWED_ORIGINS",
    "ANTHROPIC_API_KEY",
    "ASSEMBLYAI_API_KEY",
    "DATABASE_URL",
    "DEEPGRAM_API_KEY",
    "GOOGLE_API_KEY",
    "LLM_PROVIDER",
    "NEXT_PUBLIC_REALTIME_WS_URL",
    "OPENAI_API_KEY",
    "REALTIME_PORT",
    "SESSION_LOG_DIR",
    "STT_PROVIDER"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "generate": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["generate"]
    },
    "typecheck": {
      "dependsOn": ["generate"]
    },
    "test": {
      "dependsOn": ["generate"]
    }
  }
}
