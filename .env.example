# ---- Base de datos (Postgres) ----
DATABASE_URL=postgresql://postgres@localhost:5432/callpilot

# ---- Proveedores de IA ----
# Proveedor de STT en streaming: deepgram | assemblyai | fake
STT_PROVIDER=fake
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
# Proveedor LLM por defecto: anthropic | fake (openai y google se añaden después)
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---- Servidor realtime ----
REALTIME_PORT=4001
# URL del WebSocket que usa el navegador
NEXT_PUBLIC_REALTIME_WS_URL=ws://localhost:4001/ws
# Carpeta donde se escriben los JSONL de sesión (backtesting)
SESSION_LOG_DIR=./data/sessions
# URL HTTP del realtime que usa el servidor Next (por defecto se deriva de la URL del WS)
# REALTIME_HTTP_URL=http://localhost:4001

